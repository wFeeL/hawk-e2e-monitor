# Copy to .env. A value with any character other than letters, digits and -_./:@, goes in single quotes:
# Compose, Node and the shell read this file differently.
# Lines starting with "#" show the default; uncomment one to change it. Limits and dependencies between values are checked at startup.

# --- Required ---
# Unique per monitor instance: a-z, 0-9, "-", at most 12 digits, no scenario name inside.
INSTANCE_ID=
# Full /graphql address, e.g. https://api.hawk.so/graphql.
# From a container, a Hawk on the host is host.docker.internal.
HAWK_API_URL=
HAWK_PROJECT_ID=
HAWK_INTEGRATION_TOKEN=
# Admin of the project's workspace.
HAWK_EMAIL=
HAWK_PASSWORD=
# At least 32 characters A-Z, a-z, 0-9, _ and -.
RECEIVER_SECRET=
# Without compose also set one of these (compose sets TUNNEL_METRICS_URL itself):
# a public https address of the receiver, or the metrics address of a cloudflared quick tunnel.
# PUBLIC_BASE_URL=https://monitor.example.com
# TUNNEL_METRICS_URL=http://127.0.0.1:20241

# --- Recommended ---
# Address from @codex_bot after /notify_start; empty sends alerts to the log only.
# Must differ from TELEGRAM_NOTIFY_URL.
ALERT_NOTIFY_URL=
# Bearer token for POST /runs/<scenario> on the internal port (and `hem run`); empty turns manual runs off.
RUN_TOKEN=
# May stay empty for hawk.so: derived from the integration token.
HAWK_COLLECTOR_URL=

# --- Values compose overrides (setting them here has no effect under compose) ---
# INTERNAL_PORT=8090
# RECEIVER_PORT=8091
# DATABASE_PATH=data/monitor.db
# Listen addresses, 127.0.0.1 by default; the image and compose set 0.0.0.0.
# INTERNAL_HOST=127.0.0.1
# RECEIVER_HOST=127.0.0.1

# --- Host ports of compose (127.0.0.1 only) ---
# MONITOR_INTERNAL_PORT=8090
# PROMETHEUS_PORT=9090
# GRAFANA_PORT=3000

# --- Service ---
# LOG_LEVEL=info
# SHUTDOWN_TIMEOUT_MS=5000
# HEALTH_CHECK_TIMEOUT_MS=2000
# HISTORY_RETENTION_DAYS=30

# --- Schedule ---
# Also: telegram-delivery; new-project (stand only).
# SCENARIOS=send-and-receive-event,check-notification,sourcemaps,sentry-envelope,endpoints-probe
# Each run sends one or two events; removed events do not use the quota.
# CHECK_INTERVAL_MS=600000
# SOURCEMAPS_INTERVAL_MS=3600000
# SENTRY_ENVELOPE_INTERVAL_MS=3600000
# NEW_PROJECT_INTERVAL_MS=86400000
# TELEGRAM_DELIVERY_INTERVAL_MS=3600000
# WATCHDOG_GRACE_MS=30000
# SCENARIO_STAGGER_MS=30000
# Manual runs of one scenario at most this often.
# MANUAL_MIN_INTERVAL_MS=60000

# --- send-and-receive-event and timeouts ---
# alternate, http or ws.
# TRANSPORT_MODE=alternate
# Every N-th run sends the event twice; 0 turns it off.
# REPEAT_EVERY_N_RUNS=6
# HTTP_TIMEOUT_MS=5000
# COLLECTOR_AVAILABILITY_TIMEOUT_MS=15000
# API_AVAILABILITY_TIMEOUT_MS=15000
# COLLECTOR_ACCEPT_TIMEOUT_MS=10000
# EVENT_VISIBLE_TIMEOUT_MS=120000
# EVENT_REPEATED_TIMEOUT_MS=120000
# CLEANUP_TIMEOUT_MS=30000
# LATE_DUPLICATE_WAIT_MS=5000
# RUN_TIMEOUT_MS=480000
# RETRY_ATTEMPTS=3
# RETRY_DELAYS_MS=200,500
# NEW_PROJECT_TOKEN_TIMEOUT_MS=180000
# RELEASE_SAVE_TIMEOUT_MS=60000

# --- check-notification ---
# NOTIFY_LOOP=true
# NOTIFICATION_TIMEOUT_MS=120000
# NOTIFICATION_PAIR_WAIT_MS=15000
# NOTIFICATION_SETUP_TIMEOUT_MS=45000
# RULE_CACHE_WARMUP_MS=65000
# TUNNEL_READY_TIMEOUT_MS=120000

# --- telegram-delivery (off by default) ---
# Bot token and the @codex_bot address of a test group.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_NOTIFY_URL=
# TELEGRAM_CHAT_ID=
# TELEGRAM_SENDER_USERNAME=codex_bot
# TELEGRAM_DELIVERY_TIMEOUT_MS=120000
# TELEGRAM_PROBE_TIMEOUT_MS=30000
# TELEGRAM_API_URL=https://api.telegram.org

# --- Alerts and cleanup ---
# ALERT_AFTER_FAILURES=1
# ALERT_RETRY_MS=60000
# SWEEP_INTERVAL_MS=3600000
# SWEEP_MIN_AGE_MS=900000

# --- endpoints-probe ---
# Collector, API, Garage and, beside a notification scenario, the receiver behind the tunnel; no events.
# PROBE_INTERVAL_MS=90000
# PROBE_ALERT_AFTER_FAILURES=3
# PROBE_RETENTION_DAYS=7
# Garage origin, e.g. https://garage.hawk.so; empty skips the Garage stage.
# GARAGE_URL=
# GARAGE_TIMEOUT_MS=15000

# --- Heartbeat ---
# Ping address of an external heartbeat service (healthchecks.io); empty turns it off.
# HEARTBEAT_URL=
# HEARTBEAT_INTERVAL_MS=60000
