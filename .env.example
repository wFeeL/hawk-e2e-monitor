# Unique id of this monitor instance: 1-32 characters a-z, 0-9, "-".
# It goes into test event titles, so two instances must not share it.
# At most 12 digits in total.
INSTANCE_ID=

# Hawk GraphQL API, the full address of the /graphql endpoint. Pick one:
# HAWK_API_URL=http://localhost:4000/graphql
# HAWK_API_URL=https://api.hawk.so/graphql
HAWK_API_URL=

# Collector URL. Leave empty only when HAWK_API_URL is a hawk.so host: the URL
# is then derived from the integration token (https://<integrationId>.k1.hawk.so/).
# For any other API host it is required, so test events never reach production.
HAWK_COLLECTOR_URL=

# Prepared Hawk project (24 hex characters) and its integration token.
HAWK_PROJECT_ID=
HAWK_INTEGRATION_TOKEN=

# Account that is an admin of the project's workspace: it reads events and removes test events.
HAWK_EMAIL=
HAWK_PASSWORD=

LOG_LEVEL=info

# Address of the internal port (health, readiness). Defaults to 127.0.0.1;
# the container image sets 0.0.0.0. Leave it commented out when the file is
# passed to a container, otherwise the port becomes unreachable from outside.
# INTERNAL_HOST=127.0.0.1
INTERNAL_PORT=8090
SHUTDOWN_TIMEOUT_MS=5000
HEALTH_CHECK_TIMEOUT_MS=2000

# Transport of the test event: alternate (odd runs HTTP, even runs WebSocket), http or ws.
TRANSPORT_MODE=alternate
# Every N-th run of a transport also repeats the event; 0 turns repeats off.
REPEAT_EVERY_N_RUNS=6

# Time limits in milliseconds. HTTP_TIMEOUT_MS must be less than every stage limit,
# and the limits of stages 1-5 together must not exceed RUN_TIMEOUT_MS.
HTTP_TIMEOUT_MS=5000
COLLECTOR_AVAILABILITY_TIMEOUT_MS=15000
API_AVAILABILITY_TIMEOUT_MS=15000
COLLECTOR_ACCEPT_TIMEOUT_MS=10000
EVENT_VISIBLE_TIMEOUT_MS=120000
EVENT_REPEATED_TIMEOUT_MS=120000
CLEANUP_TIMEOUT_MS=30000
# Before removing the test event, cleanup waits this long and reads the event count again,
# to catch a copy that a worker counted late. 0 turns the wait off.
# LATE_DUPLICATE_WAIT_MS + 4 * HTTP_TIMEOUT_MS must not exceed CLEANUP_TIMEOUT_MS.
LATE_DUPLICATE_WAIT_MS=5000
RUN_TIMEOUT_MS=480000

# --- check-notification ---
# Address of the receiver that accepts Hawk webhook and loop notifications.
# Defaults to 127.0.0.1; the container image sets 0.0.0.0.
# RECEIVER_HOST=127.0.0.1
RECEIVER_PORT=8091
# Secret part of the receiver paths: at least 32 characters A-Z, a-z, 0-9, _ and -.
# Required by check check-notification and provision. Generate one with:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
RECEIVER_SECRET=
# Public https address of the receiver. Hawk accepts only public https hosts on port 443.
# Pick one: a fixed address (your own tunnel or reverse proxy) ...
# PUBLIC_BASE_URL=https://monitor.example.com
# ... or the metrics address of a cloudflared quick tunnel, which reports its hostname:
#   cloudflared tunnel --no-autoupdate --url http://127.0.0.1:8091 --metrics 127.0.0.1:20241
# TUNNEL_METRICS_URL=http://127.0.0.1:20241
# Also add the loop channel to the rule. Either channel arriving proves the notification.
NOTIFY_LOOP=true
# Time to wait for the notification, and for the second channel after the first.
NOTIFICATION_TIMEOUT_MS=120000
NOTIFICATION_PAIR_WAIT_MS=15000
# Time limit of resolving the address, the self-check through it and the rule update.
NOTIFICATION_SETUP_TIMEOUT_MS=30000
# Hawk's notifier caches rules for 60 s. After a rule change that affects matching,
# the process that made the change skips the notification stage of its runs for this
# long (rule_cache_warmup), and provision waits this long before it exits. Another
# process started right after provision --no-wait does not know about the change and
# may fail with notification_timeout.
RULE_CACHE_WARMUP_MS=65000

# --- continuous monitoring (serve) ---
# Scenarios that serve runs on a schedule, comma separated:
# send-and-receive-event, check-notification (needs the check-notification settings above).
SCENARIOS=send-and-receive-event
# Time between the starts of two runs of one scenario. Must exceed
# RUN_TIMEOUT_MS + CLEANUP_TIMEOUT_MS + WATCHDOG_GRACE_MS.
# Every send-and-receive run sends one event (two on repeat runs); Hawk's free plan
# allows 1000 events a month, so 10 minutes with two scenarios needs a bigger plan.
CHECK_INTERVAL_MS=600000
# A run that has not finished after RUN_TIMEOUT_MS + CLEANUP_TIMEOUT_MS + this is cancelled
# and recorded as run_hung; three in a row of one scenario restart the process.
WATCHDOG_GRACE_MS=30000
# Delay between the first runs of the scenarios after start.
SCENARIO_STAGGER_MS=30000
# The first check-notification run waits up to this long for the tunnel to work.
TUNNEL_READY_TIMEOUT_MS=120000
# Run history (SQLite). The container image keeps it in the volume at /app/data.
DATABASE_PATH=data/monitor.db
HISTORY_RETENTION_DAYS=30
# Alerts through @codex_bot: add the bot to a Telegram chat, send /notify_start,
# and put the address it answers with here. Empty: alerts only go to the log.
ALERT_NOTIFY_URL=
# Failed runs in a row before the first alert.
ALERT_AFTER_FAILURES=1
# Pause before an undelivered alert is sent again; it grows up to 10 minutes.
ALERT_RETRY_MS=60000
# Removal of test events left over by earlier runs (0 turns it off) and the age
# an event must reach before it is removed.
SWEEP_INTERVAL_MS=3600000
SWEEP_MIN_AGE_MS=900000
