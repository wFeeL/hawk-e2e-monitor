# Copy to .env. Values containing "$" go in single quotes.
# Limits and dependencies between values are checked at startup.

# --- Hawk ---
# Unique per monitor instance: a-z, 0-9, "-".
INSTANCE_ID=
# Full /graphql address, e.g. https://api.hawk.so/graphql.
# From a container, a Hawk on the host is host.docker.internal.
HAWK_API_URL=
# May stay empty for hawk.so: derived from the integration token.
HAWK_COLLECTOR_URL=
HAWK_PROJECT_ID=
HAWK_INTEGRATION_TOKEN=
# Admin of the project's workspace.
HAWK_EMAIL=
HAWK_PASSWORD=

# --- Service ---
LOG_LEVEL=info
INTERNAL_PORT=8090
SHUTDOWN_TIMEOUT_MS=5000
HEALTH_CHECK_TIMEOUT_MS=2000

# --- send-and-receive-event ---
# alternate, http or ws.
TRANSPORT_MODE=alternate
# Every N-th run sends the event twice; 0 turns it off.
REPEAT_EVERY_N_RUNS=6
HTTP_TIMEOUT_MS=5000
COLLECTOR_AVAILABILITY_TIMEOUT_MS=15000
API_AVAILABILITY_TIMEOUT_MS=15000
COLLECTOR_ACCEPT_TIMEOUT_MS=10000
EVENT_VISIBLE_TIMEOUT_MS=120000
EVENT_REPEATED_TIMEOUT_MS=120000
CLEANUP_TIMEOUT_MS=30000
LATE_DUPLICATE_WAIT_MS=5000
RUN_TIMEOUT_MS=480000
RETRY_ATTEMPTS=3
RETRY_DELAYS_MS=200,500

# --- check-notification ---
RECEIVER_PORT=8091
# At least 32 characters A-Z, a-z, 0-9, _ and -.
RECEIVER_SECRET=
# Public https address of the receiver, or the metrics address of a cloudflared
# quick tunnel (compose sets TUNNEL_METRICS_URL itself).
# PUBLIC_BASE_URL=https://monitor.example.com
# TUNNEL_METRICS_URL=http://127.0.0.1:20241
NOTIFY_LOOP=true
NOTIFICATION_TIMEOUT_MS=120000
NOTIFICATION_PAIR_WAIT_MS=15000
NOTIFICATION_SETUP_TIMEOUT_MS=30000
RULE_CACHE_WARMUP_MS=65000

# --- serve ---
# send-and-receive-event, check-notification
SCENARIOS=send-and-receive-event
# Each run sends one or two events; removed events do not use the quota.
CHECK_INTERVAL_MS=600000
WATCHDOG_GRACE_MS=30000
SCENARIO_STAGGER_MS=30000
TUNNEL_READY_TIMEOUT_MS=120000
DATABASE_PATH=data/monitor.db
HISTORY_RETENTION_DAYS=30
# Address from @codex_bot after /notify_start; empty sends alerts to the log only.
ALERT_NOTIFY_URL=
ALERT_AFTER_FAILURES=1
ALERT_RETRY_MS=60000
SWEEP_INTERVAL_MS=3600000
SWEEP_MIN_AGE_MS=900000

# --- observability ---
# Ping address of an external heartbeat service (healthchecks.io); empty turns it off.
HEARTBEAT_URL=
HEARTBEAT_INTERVAL_MS=60000
# Bearer token for POST /runs/<scenario> on the internal port; empty turns manual runs off.
RUN_TOKEN=
MANUAL_MIN_INTERVAL_MS=60000
# endpoints-probe: collector, API and Garage without events; add it to SCENARIOS to run it.
PROBE_INTERVAL_MS=90000
PROBE_ALERT_AFTER_FAILURES=3
PROBE_RETENTION_DAYS=7
# Garage origin, e.g. https://garage.hawk.so; empty skips the Garage stage.
GARAGE_URL=
GARAGE_TIMEOUT_MS=15000
# Host ports of compose (127.0.0.1 only).
# MONITOR_INTERNAL_PORT=8090
# PROMETHEUS_PORT=9090
# GRAFANA_PORT=3000
